# Password policy for the 389 Directory Server side of the harness.
#
# The other half of what OpenLDAP does in policy.ldif and slapd.conf, in the
# only shape this server has for it. 389 DS keeps the global policy as
# attributes on cn=config -- they are already there, set by the container --
# and a per-entry policy as a subentry under a container beside the entry it
# governs, which local policies must be switched on for.
#
# The container and the subentry are written with RFC 4514 escapes rather than
# the quoted form most 389 DS documentation uses: the quoted form is not a
# legal RFC 4514 DN, and Alder's dn package refuses it. Both name the same
# entry, and one of them can be read back by a client.

dn: cn=config
changetype: modify
replace: nsslapd-pwpolicy-local
nsslapd-pwpolicy-local: on
-
replace: passwordMinLength
passwordMinLength: 8
-
replace: passwordMaxAge
passwordMaxAge: 7776000
-
replace: passwordInHistory
passwordInHistory: 3
-
replace: passwordLockout
passwordLockout: on
-
replace: passwordMaxFailure
passwordMaxFailure: 5
-
replace: passwordLockoutDuration
passwordLockoutDuration: 900
-
# Lockout state has to replicate, or replication stops.
#
# When binds fail, the server writes accountUnlockTime, passwordRetryCount and
# retryCountResetTime on the account, and tries to replicate them like any
# other change. A consumer REFUSES a replicated password-policy operation
# unless this is on:
#
#   ERR - do_modify - Rejecting replicated password policy operation ...
#   To allow these changes to be accepted, set passwordIsGlobalPolicy to 'on'
#
# and the agreement then falls into "Error (16) ... connection error. Backing
# off" -- which stalls the whole agreement, not just those attributes. So one
# locked-out account silently stops replication for everything.
#
# The harness found this the first time a test locked an account out by
# failing binds rather than by writing the attribute, which is why the test
# does it that way. Any replicated 389 DS where accounts are ever locked out
# needs this set; the harness sets it because that is the real shape.
replace: passwordIsGlobalPolicy
passwordIsGlobalPolicy: on

dn: cn=nsPwPolicyContainer,ou=people,dc=alder,dc=test
changetype: add
objectClass: top
objectClass: nsContainer
cn: nsPwPolicyContainer

dn: cn=cn\=nsPwPolicyEntry\,uid\=user0004\,ou\=people\,dc\=alder\,dc\=test,cn=nsPwPolicyContainer,ou=people,dc=alder,dc=test
changetype: add
objectClass: top
objectClass: extensibleObject
objectClass: ldapsubentry
objectClass: passwordpolicy
passwordMinLength: 16
passwordMaxAge: 2592000
passwordInHistory: 10
passwordMaxFailure: 3
passwordLockout: on
passwordLockoutDuration: 3600
passwordMustChange: on

dn: uid=user0004,ou=people,dc=alder,dc=test
changetype: modify
replace: pwdpolicysubentry
pwdpolicysubentry: cn=cn\=nsPwPolicyEntry\,uid\=user0004\,ou\=people\,dc\=alder\,dc\=test,cn=nsPwPolicyContainer,ou=people,dc=alder,dc=test
