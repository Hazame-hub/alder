# Base tree for the Alder conformance harness.
#
# Applied byte-identically to OpenLDAP and 389 DS. Hand-written; everything
# below 10- is generated by test/compose/seed/gen.

dn: dc=alder,dc=test
objectClass: top
objectClass: domain
dc: alder

dn: ou=people,dc=alder,dc=test
objectClass: top
objectClass: organizationalUnit
ou: people
description: Employee entries

dn: ou=groups,dc=alder,dc=test
objectClass: top
objectClass: organizationalUnit
ou: groups
description: Access groups, including nested ones

dn: ou=services,dc=alder,dc=test
objectClass: top
objectClass: organizationalUnit
ou: services
description: Service accounts used by machines

dn: cn=svc-alder,ou=services,dc=alder,dc=test
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
cn: svc-alder
sn: Service Account
description: The account Alder itself binds as in the conformance suite
userPassword: alder-service
# A reference *out* of the hidden subtree, so that a delegated bind asking what
# points at uid=user0001 gets a shorter answer than the administrator does and
# nothing in the protocol says so. An attribute rather than a new entry, so the
# seeded entry count other tests assert stays at 320.
manager: uid=user0001,ou=people,dc=alder,dc=test
