# Custom schema for the Alder conformance harness, in slapd.conf format.
#
# The 389 DS equivalent lives in test/compose/ds389/alder-schema.ldif and must
# be kept identical in meaning. The definitions are deliberately unremarkable
# except in the ways that matter for testing: one single-valued directory
# string, one boolean, one binary attribute whose values force base64 encoding
# in LDIF, and one auxiliary class with both a MUST and a MAY.
#
# OID arc 1.3.6.1.4.1.99999 is the conventional example arc. Nothing here is
# registered and nothing here should ever reach a real directory.

attributetype ( 1.3.6.1.4.1.99999.1.1
	NAME 'alderTeam'
	DESC 'Team the person belongs to'
	EQUALITY caseIgnoreMatch
	SUBSTR caseIgnoreSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
	SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.99999.1.2
	NAME 'alderOnCall'
	DESC 'Whether the person is in the on-call rotation'
	EQUALITY booleanMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
	SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.99999.1.3
	NAME 'alderBadgePhoto'
	DESC 'Badge photograph, binary'
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.28 )

attributetype ( 1.3.6.1.4.1.99999.1.4
	NAME 'alderNote'
	DESC 'Free text note, multi-valued'
	EQUALITY caseIgnoreMatch
	SUBSTR caseIgnoreSubstringsMatch
	SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

objectclass ( 1.3.6.1.4.1.99999.2.1
	NAME 'alderEmployee'
	DESC 'Alder test employee'
	SUP top
	AUXILIARY
	MUST ( alderTeam )
	MAY ( alderOnCall $ alderBadgePhoto $ alderNote ) )
