/bin/
/dist/
/web/node_modules/
/web/dist/
/test/compose/certs/
*.test
*.out
.DS_Store
# The SPA build output is generated; the directory itself is not, because
# //go:embed fails on a missing directory.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Task’s local up-to-date cache. Machine-specific; never shared.
/.task/

# TypeScript incremental build state. Machine-specific, like .task/.
*.tsbuildinfo

# Generated bulk filler for scale work, written on demand by "task compose:bulk".
# Never committed: a hundred thousand entries is about 40 MB, and that is not
# something every clone should carry for a measurement taken a few times a year.
# The directory itself is kept, because docker-compose.yml bind-mounts it.
/test/compose/bulk/*.ldif
